ARG BASE_IMAGE=frappe/build:develop@sha256:85096a2d39b32a6d9a7cc6977fdeeb7fdc551c5ced124c34e26d2e4ac54339f4
FROM ${BASE_IMAGE} AS bench-builder

USER root
RUN mkdir -p /opt/logicx/sources && chown -R frappe:0 /opt/logicx
COPY --chown=frappe:0 .container/dev-versions.json .container/build_dev_bench.py /opt/logicx/
USER frappe
RUN python /opt/logicx/build_dev_bench.py

FROM ${BASE_IMAGE}
USER root
COPY --from=bench-builder --chown=frappe:0 /home/frappe/frappe-bench /home/frappe/frappe-bench
COPY --from=bench-builder --chown=frappe:0 /opt/logicx/sources /opt/logicx/sources
COPY .container/dev-versions.json /opt/logicx/dev-versions.json
COPY .container/init_frappe.py .container/dev_verify.py .container/dev-entrypoint.sh /opt/logicx/
RUN sed -i 's/\r$//' /opt/logicx/dev-entrypoint.sh
WORKDIR /home/frappe/frappe-bench
ENV HOME=/home/frappe
EXPOSE 4445 4446
ENTRYPOINT ["/bin/bash", "/opt/logicx/dev-entrypoint.sh"]
CMD ["start"]
